#!/bin/sh
# Ianua init — installs an AI tool adapter.
# Usage: ./scripts/init [claude-code|github-copilot|cursor|generic]
#
# Nested mode: if this script lives at <project>/.ianua/scripts/init (i.e. the Ianua core was
# cloned into a ".ianua" folder inside an existing repo instead of *being* the repo root), the
# adapter's discovery files (AGENTS.md, CLAUDE.md, .claude/, .agents/, .codex/, .cursor/,
# .github/copilot-instructions.md — whatever a given tool needs at the project root to find it)
# are symlinked from the project root into .ianua/, instead of copied. Nothing is duplicated:
# .ianua/ stays the single source of truth, the project root only gets pointers into it, and
# re-running this script after `git pull`-ing .ianua/ needs no re-copy. Everything scripts/init
# places outside .ianua/ is meant to be gitignored — see the note this prints in nested mode.
set -e
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ADAPTERS="$ROOT/adapters"

case "$(basename "$ROOT")" in
  .ianua) NESTED=1; PROJECT_ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd) ;;
  *)      NESTED=0; PROJECT_ROOT="$ROOT" ;;
esac

usage() {
  echo "Usage: ./scripts/init <adapter>"
  echo ""
  echo "Available adapters:"
  echo "  claude-code      CLAUDE.md + .claude/ (commands, reviewer subagent, permissions, hooks)"
  echo "  codex            .agents/skills/ (workflow skills) + .codex/ (policy hook, config)"
  echo "  github-copilot   .github/copilot-instructions.md pointer"
  echo "  cursor           .cursor/rules/ pointer"
  echo "  generic          nothing to install — prints wiring instructions"
}

[ $# -eq 1 ] || { usage; exit 1; }

# link SRC (absolute, inside .ianua/) DEST (absolute, at PROJECT_ROOT) — nested mode only.
link() {
  src="$1"; dest="$2"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "SKIP: $dest already exists and isn't a symlink — remove it yourself if you want Ianua to manage it." >&2
    return
  fi
  rm -f "$dest"
  ln -s "$src" "$dest"
}

gitignore_note() {
  gi="$PROJECT_ROOT/.gitignore"
  [ -f "$gi" ] || return
  grep -qxF ".ianua" "$gi" 2>/dev/null && return
  { echo ""; echo "# Ianua (nested install — see .ianua/README.md)"; echo ".ianua"; } >> "$gi"
  echo "Added .ianua to .gitignore."
}

case "$1" in
  claude-code)
    if [ "$NESTED" = 1 ]; then
      link "$ROOT/AGENTS.md" "$PROJECT_ROOT/AGENTS.md"
      link "$ADAPTERS/claude-code/.claude" "$PROJECT_ROOT/.claude"
      # CLAUDE.md is written, not symlinked: it needs a nested-mode note appended, and it's the
      # one file Claude Code auto-loads unconditionally every turn, so this is the most reliable
      # place to teach the agent that bare Ianua paths (workflows/x, docs/y, ...) live under
      # .ianua/ here, not at the project root.
      if [ -e "$PROJECT_ROOT/CLAUDE.md" ] && [ ! -L "$PROJECT_ROOT/CLAUDE.md" ]; then
        echo "SKIP: $PROJECT_ROOT/CLAUDE.md already exists and isn't managed by this script — remove it yourself if you want Ianua to manage it." >&2
      else
        rm -f "$PROJECT_ROOT/CLAUDE.md"
        cat "$ADAPTERS/claude-code/CLAUDE.md" > "$PROJECT_ROOT/CLAUDE.md"
        cat >> "$PROJECT_ROOT/CLAUDE.md" <<'EOF'

**Nested install.** This project uses Ianua from a `.ianua/` folder (not copied to the root). Only
`AGENTS.md`, `CLAUDE.md`, and `.claude/` are actually here — every other bare Ianua path any file
mentions (`workflows/x`, `docs/y`, `specs/z`, `prompts/w`, `scripts/check`, ...) lives under
`.ianua/` instead. Resolve `workflows/x` as `.ianua/workflows/x`, etc., for every such path you hit
in AGENTS.md, workflows/, prompts/, or any `.claude/commands/`/`.claude/agents/` file — don't
conclude you need to run from inside `.ianua/`.
EOF
      fi
      gitignore_note
      echo "Installed (nested): AGENTS.md, .claude/ (symlinks into .ianua/), CLAUDE.md (generated)."
    else
      cp "$ADAPTERS/claude-code/CLAUDE.md" "$ROOT/CLAUDE.md"
      mkdir -p "$ROOT/.claude"
      cp -R "$ADAPTERS/claude-code/.claude/." "$ROOT/.claude/"
      chmod +x "$ROOT/.claude/hooks/"*.sh 2>/dev/null || true
      echo "Installed: CLAUDE.md, .claude/ (commands, agents, hooks, settings)."
    fi
    if [ "$NESTED" = 1 ]; then
      echo "Next: cd $PROJECT_ROOT  (NOT .ianua/ — Claude Code must be launched from there), then run /bootstrap"
    else
      echo "Next: open Claude Code here and run /bootstrap"
    fi
    ;;
  codex)
    if [ "$NESTED" = 1 ]; then
      link "$ROOT/AGENTS.md" "$PROJECT_ROOT/AGENTS.md"
      link "$ADAPTERS/codex/.agents" "$PROJECT_ROOT/.agents"
      link "$ADAPTERS/codex/.codex" "$PROJECT_ROOT/.codex"
      gitignore_note
      echo "Installed (nested): AGENTS.md, .agents/, .codex/ — all symlinks into .ianua/."
    else
      mkdir -p "$ROOT/.agents/skills" "$ROOT/.codex/hooks"
      cp -R "$ADAPTERS/codex/.agents/skills/." "$ROOT/.agents/skills/"
      cp -R "$ADAPTERS/codex/.codex/." "$ROOT/.codex/"
      echo "Installed: .agents/skills/ (workflow skills), .codex/hooks.json + .codex/hooks/ (policy hook), .codex/config.toml."
    fi
    if [ "$NESTED" = 1 ]; then
      echo "Next: cd $PROJECT_ROOT  (NOT .ianua/), trust it, run 'codex', then invoke the bootstrap skill."
    else
      echo "Next: run 'codex' once in this repo and trust it (see adapters/codex/README.md), then invoke the bootstrap skill."
    fi
    ;;
  github-copilot)
    if [ "$NESTED" = 1 ]; then
      mkdir -p "$PROJECT_ROOT/.github"
      link "$ADAPTERS/github-copilot/copilot-instructions.md" "$PROJECT_ROOT/.github/copilot-instructions.md"
      gitignore_note
      echo "Installed (nested): .github/copilot-instructions.md — symlink into .ianua/."
    else
      mkdir -p "$ROOT/.github"
      cp "$ADAPTERS/github-copilot/copilot-instructions.md" "$ROOT/.github/copilot-instructions.md"
      echo "Installed: .github/copilot-instructions.md."
    fi
    echo "Next: open Copilot chat and paste prompts/bootstrap.md"
    ;;
  cursor)
    if [ "$NESTED" = 1 ]; then
      mkdir -p "$PROJECT_ROOT/.cursor/rules"
      link "$ADAPTERS/cursor/rules/ianua.mdc" "$PROJECT_ROOT/.cursor/rules/ianua.mdc"
      gitignore_note
      echo "Installed (nested): .cursor/rules/ianua.mdc — symlink into .ianua/."
    else
      mkdir -p "$ROOT/.cursor/rules"
      cp "$ADAPTERS/cursor/rules/ianua.mdc" "$ROOT/.cursor/rules/ianua.mdc"
      echo "Installed: .cursor/rules/ianua.mdc."
    fi
    echo "Next: open Cursor here and paste prompts/bootstrap.md"
    ;;
  generic)
    echo "Nothing to install. See adapters/generic/README.md for wiring any tool:"
    echo "paste AGENTS.md at session start, drive workflows/ manually, review in a fresh session."
    ;;
  -h|--help) usage ;;
  *)
    echo "Unknown adapter: $1" >&2
    usage
    exit 1
    ;;
esac
